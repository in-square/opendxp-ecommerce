    "require": {
        "doctrine/data-fixtures": "^1.5",
        "doctrine/doctrine-bundle": "^2.15",
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "doctrine/orm": "^3.6",
        "ext-json": "*",
        "fakerphp/faker": "^1.16",
        "gedmo/doctrine-extensions": "^3.11",
        "jms/serializer-bundle": "^4.0 | ^5.0",
        "knplabs/knp-menu-bundle": "^3.1",
        "laminas/laminas-stdlib": "^3.6",
        "laminas/laminas-zendframework-bridge": "^1.5",
        "open-dxp/admin-bundle": "^1.2",
        "open-dxp/google-marketing-bundle": "^1.0",
        "open-dxp/newsletter-bundle": "^1.0",
        "open-dxp/opendxp": "^1.3",
        "open-dxp/web-to-print-bundle": "^1.1",
        "payum/payum": "^1.7",
        "payum/payum-bundle": "^2.6",
        "php": "^8.3",
        "php-http/guzzle7-adapter": "^1.0",
        "php-http/message-factory": "^1.1",
        "rinvex/countries": "^7.3",
        "sebastian/diff": "^4.0 | ^5.0 | ^6.0 | ^7.0",
        "stof/doctrine-extensions-bundle": "^1.6",
        "sylius/theme-bundle": "^2.2",
        "symfony/dotenv": "^7.4",
        "symfony/form": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/intl": "^7.4",
        "symfony/notifier": "^7.4",
        "symfony/serializer": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "webmozart/assert": "^1.10"
    },
    "suggest": {},
    "require-dev": {
        "behat/behat": "^3.22",
        "behat/mink": "^1.12",
        "chrome-php/chrome": "^1.11",
        "dbrekelmans/bdi": "^1.0",
        "friends-of-behat/mink-debug-extension": "^2.0",
        "friends-of-behat/mink-extension": "^2.4",
        "friends-of-behat/page-object-extension": "^0.3.2",
        "friends-of-behat/symfony-extension": "^2.1",
        "gotenberg/gotenberg-php": "^2.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.0",
        "robertfausk/behat-panther-extension": "^1.0",
        "symfony/panther": "^2.2",
        "symfony/runtime": "^7.4",
        "symplify/easy-coding-standard": "^11.1",
        "vimeo/psalm": "^6.10"
    },
    "conflict": {
        "jms/serializer-bundle": "4.1.0",
        "twig/twig": ">=3.9.0 <3.14.0"
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Bundle\\": "src/CoreShop/Bundle/",
            "CoreShop\\Component\\": "src/CoreShop/Component/",
            "CoreShop\\Behat\\": "src/CoreShop/Behat/"
        },
        "exclude-from-classmap": [
            "src/CoreShop/*/*/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenDxp\\Model\\DataObject\\": [
                "var/classes/DataObject",
                "var/tmp/behat/var/classes/DataObject"
            ]
        },
        "classmap": [
            "src/Kernel.php",
            "src/BehatKernel.php",
            "src/AppKernel.php"
        ]
    },
    "extra": {
        "symfony-bin-dir": "bin",
        "symfony-var-dir": "var",
        "symfony-tests-dir": "tests",
        "symfony-assets-install": "relative",
        "branch-alias": {
            "dev-next": "4.1-dev",
            "dev-4.1": "4.1-dev",
            "dev-opendxp-migration-base": "4.1-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": false,
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    }
}
