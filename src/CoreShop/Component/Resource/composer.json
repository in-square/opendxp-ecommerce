{
    "name": "coreshop/resource",
    "type": "library",
    "description": "CoreShop Resource Component.",
    "keywords": [
        "coreshop",
        "opendxp",
        "ecommerce"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "coreshop/locale": "^4.0",
        "coreshop/opendxp": "^4.0",
        "doctrine/collections": "^2.2",
        "doctrine/orm": "^3.6",
        "open-dxp/opendxp": "^1.3",
        "php": "^8.3",
        "symfony/finder": "^7.4",
        "webmozart/assert": "^1.10"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Component\\Resource\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "4.1-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
