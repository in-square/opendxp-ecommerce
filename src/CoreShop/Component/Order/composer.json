{
    "name": "coreshop/order",
    "type": "library",
    "description": "CoreShop Order Component.",
    "keywords": [
        "coreshop",
        "opendxp",
        "ecommerce"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "coreshop/address": "^4.0",
        "coreshop/currency": "^4.0",
        "coreshop/customer": "^4.0",
        "coreshop/opendxp": "^4.0",
        "coreshop/payment": "^4.0",
        "coreshop/registry": "^4.0",
        "coreshop/resource": "^4.0",
        "coreshop/rule": "^4.0",
        "coreshop/sequence": "^4.0",
        "coreshop/storage-list": "^4.0",
        "coreshop/store": "^4.0",
        "coreshop/taxation": "^4.0",
        "coreshop/workflow-bundle": "^4.0",
        "laminas/laminas-stdlib": "^3.6",
        "open-dxp/opendxp": "^1.3",
        "php": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Component\\Order\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "4.1-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
