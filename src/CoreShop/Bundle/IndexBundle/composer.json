{
    "name": "coreshop/index-bundle",
    "type": "opendxp-bundle",
    "description": "CoreShop - Index Bundle",
    "keywords": [
        "coreshop",
        "opendxp",
        "ecommerce"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "coreshop/index": "^4.0",
        "coreshop/menu-bundle": "^4.0",
        "coreshop/registry": "^4.1",
        "coreshop/resource-bundle": "^4.0",
        "doctrine/migrations": "^3.9",
        "open-dxp/opendxp": "^1.3",
        "php": "^8.3"
    },
    "suggest": {},
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Bundle\\IndexBundle\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "4.1-dev"
        },
        "opendxp": {
            "bundles": [
                "CoreShop\\Bundle\\IndexBundle\\CoreShopIndexBundle"
            ]
        }
    }
}
