{
    "name": "coreshop/workflow-bundle",
    "type": "opendxp-bundle",
    "description": "CoreShop - Workflow Bundle",
    "keywords": [
        "coreshop",
        "opendxp",
        "ecommerce",
        "workflow"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        },
        {
            "name": "Stefan Hagspiel",
            "email": "shagspiel@dachcom.com",
            "role": "Developer"
        }
    ],
    "require": {
        "coreshop/opendxp": "^4.0",
        "coreshop/registry": "^4.1",
        "open-dxp/opendxp": "^1.3",
        "php": "^8.3",
        "symfony/config": "^7.4",
        "symfony/workflow": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Bundle\\WorkflowBundle\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "4.1-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
