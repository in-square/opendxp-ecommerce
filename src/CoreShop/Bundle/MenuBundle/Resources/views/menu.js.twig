opendxp.registerNS('coreshop.menu.{{ type }}');
coreshop.menu.{{ type }} = Class.create({
    initialize: function () {
        var type = '{{ type }}';
        {{ knp_menu_render(type, {}, 'json')|raw }}
        var toolbar = opendxp.globalmanager.get('layout_toolbar');

        if (menu.length > 0) {
            var menuItems = [];

            var loopMenu = function(item, menuItems) {
                var menuItem = {
                    text: t(item.name),
                    iconCls: item.attributes.iconCls,
                    handler: function() {
                        const openMenuEvent = new CustomEvent(coreshop.events.menu.open, {
                            detail: {
                                type: type,
                                item: item
                            }
                        });

                        document.dispatchEvent(openMenuEvent);
                    }
                };

                if (item.hasOwnProperty('children')) {
                    var childrenItems = [];

                    Ext.each(item.children, function(child) {
                        loopMenu(child, childrenItems);
                    });

                    menuItem['menu'] = {
                        cls: 'opendxp_navigation_flyout',
                        shadow: false,
                        items: childrenItems
                    };
                }
                else if (item.attributes.hasOwnProperty('container') && item.attributes.container) {
                    return;
                }

                menuItems.push(menuItem);
            };

            Ext.each(menu, function(item) {
                loopMenu(item, menuItems);
            });

            var extMenu = new Ext.menu.Menu({
                items: menuItems,
                shadow: false,
                cls: 'opendxp_navigation_flyout'
            });

            var classes = ['opendxp_menu_item', 'opendxp_menu_needs_children'];

            if (item.attributes.hasOwnProperty('class')) {
                classes.push(item.attributes.class);
            }

            Ext.get('opendxp_navigation').down('ul').insertHtml('beforeEnd',
                '<li id="opendxp_menu_{{ typeId }}" data-menu-tooltip="' + t(item.name) + '" class="'+classes.join(' ')+'">' +
                (item.attributes.hasOwnProperty('content') ? item.attributes.content : '') +
                '</li>');

            Ext.get('opendxp_menu_{{ typeId }}').on('mousedown', function (e, el) {
                toolbar.showSubMenu.call(extMenu, e, el);
            }.bind(this));

            opendxp.helpers.initMenuTooltips();
        }
    }
});
