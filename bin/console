use OpenDxp\Bootstrap;
use OpenDxp\Console\Application;

$autoload = dirname(__DIR__) . '/vendor/autoload_runtime.php';

if (!is_file($autoload)) {
    throw new LogicException('CoreShop standalone dependencies are missing. Run composer install in the CoreShop directory. For an embedded installation, use the host application bin/console.');
}

require_once $autoload;

return static function (): Application {
    if (!defined('OPENDXP_CONSOLE')) {
        define('OPENDXP_CONSOLE', true);
    }

    if (!defined('OPENDXP_PROJECT_ROOT')) {
        define('OPENDXP_PROJECT_ROOT', $_SERVER['OPENDXP_PROJECT_ROOT'] ?? $_ENV['OPENDXP_PROJECT_ROOT'] ?? getenv('OPENDXP_PROJECT_ROOT') ?: dirname(__DIR__));
    }

    if (!defined('OPENDXP_KERNEL_CLASS')) {
        define('OPENDXP_KERNEL_CLASS', $_SERVER['OPENDXP_KERNEL_CLASS'] ?? $_ENV['OPENDXP_KERNEL_CLASS'] ?? getenv('OPENDXP_KERNEL_CLASS') ?: 'Kernel');
    }

    return new Application(Bootstrap::startupCli());
};
